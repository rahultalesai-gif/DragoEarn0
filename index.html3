        <div><h3 class="text-base font-extrabold text-jungle-neon font-mono">TAP FORGE</h3><p class="text-[10px] text-gray-300 font-mono">Level <span id="boost-level-text" class="text-jungle-neon font-bold">1</span> Power</p></div>
      </div>
      <div class="bg-black/40 p-3 rounded-2xl border border-jungle-neon/20 flex justify-between items-center text-xs font-mono"><span class="text-gray-400">Current Power:</span><span class="font-extrabold text-jungle-neon text-sm" id="modal-tap-power">+1 / Tap</span></div>
      <button class="w-full bg-gradient-to-r from-amber-400 via-jungle-amber to-amber-500 text-black font-black py-3 rounded-2xl text-xs active:scale-95 shadow-lg flex items-center justify-between px-4 font-mono" onclick="buyTapBoostWithCoins(event)">
        <span id="boost-upgrade-title">UPGRADE (+1/TAP)</span><span class="bg-black/25 px-2.5 py-0.5 rounded-full text-white" id="boost-cost-badge">1,000 🪙</span>
      </button>
    </div>
  </div>
  
  <div id="energy-modal" class="fixed inset-0 z-[100] bg-black/80 backdrop-blur-md hidden items-center justify-center p-4">
    <div class="upgrade-card rounded-3xl p-5 w-full max-w-xs flex flex-col gap-3.5 border-jungle-amber/50 shadow-2xl relative popup-animate-in">
      <button class="absolute top-3 right-3 text-gray-400 hover:text-white text-lg font-bold" onclick="closeModal('energy-modal')">✕</button>
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-amber-500/15 border border-amber-400/40 flex items-center justify-center text-2xl shadow-inner">🔋</div>
        <div><h3 class="text-base font-extrabold text-jungle-amber font-mono">MANA TANK</h3><p class="text-[10px] text-gray-300 font-mono">Tier <span id="energy-level-text" class="text-jungle-amber font-bold">1</span> Capacity</p></div>
      </div>
      <div class="bg-black/40 p-3 rounded-2xl border border-jungle-amber/20 flex justify-between items-center text-xs font-mono"><span class="text-gray-400">Current Storage:</span><span class="font-extrabold text-jungle-amber text-sm" id="modal-energy-status">1000 / 1000</span></div>
      <button class="w-full bg-amber-500 text-black font-black py-3 rounded-2xl text-xs active:scale-95 shadow-md flex items-center justify-between px-4 font-mono" onclick="upgradeMaxEnergyWithCoins(event)">
        <span id="energy-upgrade-title">+500 CAPACITY</span><span class="bg-black/25 px-2.5 py-0.5 rounded-full text-white" id="energy-cost-badge">1,000 🪙</span>
      </button>
    </div>
  </div>

  <!-- ================= SCRIPT LOGIC ================= -->
  <script>
    // 🛠️ TERA FIREBASE CONFIG
    const firebaseConfig = {
      apiKey: "AIzaSyB0rU66g1GZfgxgLXnwArXwRFRmPg_Vnno",
      authDomain: "dragoearn.firebaseapp.com",
      projectId: "dragoearn",
      storageBucket: "dragoearn.firebasestorage.app",
      messagingSenderId: "16790312883",
      appId: "1:16790312883:web:51893b17b34394d240ddc6"
    };
    if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore();

    const tg = window.Telegram?.WebApp;
    if (tg) {
      try {
        tg.ready();
        tg.expand();
        if (tg.enableClosingConfirmation) tg.enableClosingConfirmation();
      } catch (e) { console.log("TG WebApp Error:", e); }
    }

    // UNIQUE REFERRAL CODE GENERATOR
    let myReferralCode = localStorage.getItem('draco_ref_code');
    if (!myReferralCode) {
        myReferralCode = 'DRAGO' + Math.random().toString(36).substr(2, 6).toUpperCase();
        localStorage.setItem('draco_ref_code', myReferralCode);
    }
    
    function initTelegramUser() {
      if (tg && tg.initDataUnsafe && tg.initDataUnsafe.user) {
        const u = tg.initDataUnsafe.user;
        const nameEl = document.getElementById('tg-user-name');
        const handleEl = document.getElementById('tg-user-handle');
        
        if (nameEl) {
          const fullName = (u.first_name || '') + (u.last_name ? ' ' + u.last_name : '');
          nameEl.textContent = fullName.trim().toUpperCase() || 'JUNGLE EXPLORER';
        }
        if (handleEl) {
          handleEl.textContent = u.username || u.first_name || 'player';
        }
      }
    }

    const boostCosts = [1000, 3000, 6000, 10000, 15000, 25000, 40000];
    const energyCosts = [1000, 3000, 6000, 10000, 15000, 25000, 40000];
    const dailyRewards = [100, 150, 250, 400, 600, 850, 1500];

    let gold = parseInt(localStorage.getItem('draco_gold')) || 0;
    let boostLevel = parseInt(localStorage.getItem('draco_boost_lvl')) || 1;
    let energyLevel = parseInt(localStorage.getItem('draco_energy_lvl')) || 1;
    let maxEnergy = 1000 + (energyLevel - 1) * 500;
    let energy = parseInt(localStorage.getItem('draco_energy'));
    if (isNaN(energy)) energy = maxEnergy;

    let soundEnabled = localStorage.getItem('draco_sound') !== 'false';
    
    let currentStreakDay = parseInt(localStorage.getItem('draco_streak_day')) || 1;
    let lastClaimDate = localStorage.getItem('draco_last_claim_date') || '';
    
    if (lastClaimDate && lastClaimDate !== new Date().toDateString()) {
      let lastDate = new Date(lastClaimDate);
      let today = new Date(new Date().toDateString());
      let diff = today - lastDate;
      if (diff > 86400000) { currentStreakDay = 1; } 
      else { currentStreakDay = currentStreakDay >= 7 ? 1 : currentStreakDay + 1; }
      localStorage.setItem('draco_streak_day', currentStreakDay);
    }
    
    let playHistoryCount = parseInt(localStorage.getItem('draco_play_count')) || 0;
    let spinTickets = parseInt(localStorage.getItem('draco_spin_tkts')) || 0;
    let boxTickets = parseInt(localStorage.getItem('draco_box_tkts')) || 0; 
    let isDailyClaiming = false;
    let spinRot = 0, isSpinning = false, isBoxRolling = false, currentWithdrawMethod = '';

    // 🔥 OPTIMIZED FIREBASE SYNC WITH REFERRAL CODE
    let lastSyncedGold = gold;
    function syncToDatabase() {
      if (gold === lastSyncedGold) return; 
      let tgUserId = tg?.initDataUnsafe?.user?.id || 'guest_user';
      if (db) {
        db.collection('users').doc(String(tgUserId)).set({
          user_id: tgUserId,
          username: tg?.initDataUnsafe?.user?.username || 'player',
          gold: gold,
          boostLevel: boostLevel,
          energyLevel: energyLevel,
          referral_code: myReferralCode,
          last_active: new Date().toISOString()
        }, { merge: true });
      }
      lastSyncedGold = gold;
    }
    setInterval(syncToDatabase, 180000); 
    window.addEventListener('visibilitychange', () => { if (document.hidden) syncToDatabase(); });

    // 🏆 REAL-TIME FIREBASE LEADERBOARD FETCHING 
    async function loadLeaderboardFromFirebase() {
      const remainingEl = document.getElementById('leaderboard-remaining');
      const rank1Name = document.getElementById('lb-rank1-name');
      const rank1Gold = document.getElementById('lb-rank1-gold');
      const rank2Name = document.getElementById('lb-rank2-name');
      const rank2Gold = document.getElementById('lb-rank2-gold');
      const rank3Name = document.getElementById('lb-rank3-name');
      const rank3Gold = document.getElementById('lb-rank3-gold');

      if (!db) return;

      try {
        const snap = await db.collection('users').orderBy('gold', 'desc').limit(20).get();
        if (snap.empty) {
          if (remainingEl) remainingEl.innerHTML = `<div class="text-center text-xs text-gray-400 py-4">No players registered yet!</div>`;
          return;
        }

        let users = [];
        snap.forEach(doc => users.push(doc.data()));

        if (users[0]) {
          if (rank1Name) rank1Name.textContent = users[0].username || 'Master';
          if (rank1Gold) rank1Gold.textContent = (users[0].gold || 0).toLocaleString() + ' 🪙';
        }
        if (users[1]) {
          if (rank2Name) rank2Name.textContent = users[1].username || 'Explorer';
          if (rank2Gold) rank2Gold.textContent = (users[1].gold || 0).toLocaleString() + ' 🪙';
        }
        if (users[2]) {
          if (rank3Name) rank3Name.textContent = users[2].username || 'Explorer';
          if (rank3Gold) rank3Gold.textContent = (users[2].gold || 0).toLocaleString() + ' 🪙';
        }

        if (remainingEl) {
          remainingEl.innerHTML = '';
          if (users.length <= 3) {
            remainingEl.innerHTML = `<div class="text-center text-[10px] text-gray-500 py-2">More players will appear as they join!</div>`;
          } else {
            for (let i = 3; i < 20; i++) {
              if (users[i]) {
                const u = users[i];
                remainingEl.innerHTML += `
                  <div class="jungle-panel rounded-xl p-3 flex items-center justify-between border border-jungle-neon/20 hover:bg-emerald-900/30 transition-colors">
                    <div class="flex items-center gap-4">
                      <div class="w-7 h-7 rounded-full bg-jungle-surface border border-gray-600 text-gray-300 font-bold flex items-center justify-center text-xs shadow-inner">${i + 1}</div>
                      <span class="font-bold text-sm text-gray-200">${u.username || 'Explorer'}</span>
                    </div>
                    <span class="font-mono text-xs text-jungle-neon font-bold">${(u.gold || 0).toLocaleString()} 🪙</span>
                  </div>
                `;
              } else {
                 remainingEl.innerHTML += `
                  <div class="jungle-panel rounded-xl p-3 flex items-center justify-between border border-jungle-neon/20 opacity-40">
                    <div class="flex items-center gap-4">
                      <div class="w-7 h-7 rounded-full bg-jungle-surface border border-gray-600 text-gray-500 font-bold flex items-center justify-center text-xs shadow-inner">${i + 1}</div>
                      <span class="font-bold text-sm text-gray-500">---</span>
                    </div>
                    <span class="font-mono text-xs text-gray-500 font-bold">0 🪙</span>
                  </div>
                `;
              }
            }
          }
        }

        let myTgId = String(tg?.initDataUnsafe?.user?.id || 'guest_user');
        let myName = tg?.initDataUnsafe?.user?.username || tg?.initDataUnsafe?.user?.first_name || 'player';
        
        let myRankBadge = document.getElementById('lb-my-rank-badge');
        let myRankText = document.getElementById('lb-user-name');
        let myGoldText = document.getElementById('leaderboard-my-gold');

        if (myRankText) myRankText.textContent = myName === 'player' ? 'You' : myName;
        if (myGoldText) myGoldText.textContent = gold.toLocaleString() + ' 🪙';

        if (myRankBadge) {
          let index = users.findIndex(u => String(u.user_id) === myTgId || u.username === myName);
          if (index !== -1) {
            myRankBadge.textContent = `#${index + 1}`;
          } else {
            myRankBadge.textContent = `#99+`;
          }
        }
      } catch (err) { console.log("Error loading real leaderboard:", err); }
    }

    function showGameAlert(t, m, i, hideBtn=false) { 
      document.getElementById('alert-title').textContent = t; 
      document.getElementById('alert-message').textContent = m; 
      const iconEl = document.getElementById('alert-icon');
      if(i === '⏳') { iconEl.innerHTML = `<span class="inline-block animate-spin-fast text-4xl">⏳</span>`; } else { iconEl.innerHTML = i; }
      const btn = document.getElementById('alert-close-btn');
      if(hideBtn) { btn.classList.add('hidden'); } else { btn.classList.remove('hidden'); }
      document.getElementById('game-alert-modal').classList.remove('hidden'); document.getElementById('game-alert-modal').classList.add('flex'); 
    }
    function closeGameAlert() { document.getElementById('game-alert-modal').classList.add('hidden'); document.getElementById('game-alert-modal').classList.remove('flex'); }
    
    function openReferralModal() { 
      const linkDisplay = document.getElementById('ref-link-display');
      linkDisplay.textContent = `https://t.me/DragoEarnBot?start=${myReferralCode}`;
      document.getElementById('referral-modal').classList.remove('hidden'); 
      document.getElementById('referral-modal').classList.add('flex'); 
    }
    
    function openReferralTrackModal() { closeModal('referral-modal'); document.getElementById('referral-track-modal').classList.remove('hidden'); document.getElementById('referral-track-modal').classList.add('flex'); }

    function copyReferralLink() { 
      const link = `https://t.me/DragoEarnBot?start=${myReferralCode}`;
      navigator.clipboard.writeText(link).then(() => {
          showGameAlert('LINK COPIED', 'Invitation link copied!\n(' + link + ')', '🔗'); 
      }).catch(err => {
          showGameAlert('LINK COPIED', 'Please copy manually:\n' + link, '🔗'); 
      });
      closeModal('referral-modal'); 
    }

    function openWithdrawModal(method) {
      currentWithdrawMethod = method; document.getElementById('withdraw-title').textContent = `WITHDRAW ${method}`;
      document.getElementById('withdraw-icon').textContent = method === 'UPI' ? '🏦' : '💎';
      document.getElementById('withdraw-address-input').placeholder = method === 'UPI' ? 'e.g. 9003056016@ybl' : 'EQ...';
      document.getElementById('withdraw-modal').classList.remove('hidden'); document.getElementById('withdraw-modal').classList.add('flex');
    }
    
    function calculateWithdrawValue() {
      const amt = parseInt(document.getElementById('withdraw-amount-input').value) || 0;
      const calc = document.getElementById('withdraw-calc-text');
      if (amt < 100000) { calc.textContent = 'Min 100,000 🪙'; return; }
      calc.textContent = currentWithdrawMethod === 'UPI' ? `Value: ₹${(amt/1000).toFixed(2)}` : `Value: ${(amt/100000 * 0.74).toFixed(2)} TON`;
    }
    
    function submitWithdrawal() {
      const addr = document.getElementById('withdraw-address-input').value; 
      const amt = parseInt(document.getElementById('withdraw-amount-input').value) || 0;
      const err = document.getElementById('withdraw-error-text');
      err.classList.add('hidden'); 

      if (!addr) { err.textContent = 'Please enter an address or ID'; err.classList.remove('hidden'); return; }
      if (amt < 100000) { err.textContent = 'Min withdrawal is 100K 🪙'; err.classList.remove('hidden'); return; }
      if (gold < amt) { err.textContent = 'Insufficient Balance!'; err.classList.remove('hidden'); return; }
      
      gold -= amt; updateUI(); closeModal('withdraw-modal'); syncToDatabase();
      showGameAlert('SUCCESS', `Coins Deducted! ${amt} 🪙 payment will arrive in 24-48 hours.`, '✅');
    }

    let audioCtx = null;
    function initAudio() { if(!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)(); if(audioCtx.state === 'suspended') audioCtx.resume(); }
    function playCrispCoinSFX() { if(!soundEnabled || !audioCtx) return; try { const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain(); osc.type = 'triangle'; osc.frequency.setValueAtTime(600, audioCtx.currentTime); osc.frequency.exponentialRampToValueAtTime(1200, audioCtx.currentTime + 0.1); gain.gain.setValueAtTime(0.3, audioCtx.currentTime); gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1); osc.connect(gain); gain.connect(audioCtx.destination); osc.start(); osc.stop(audioCtx.currentTime + 0.1); } catch(e){} }
    function toggleSound() { soundEnabled = !soundEnabled; localStorage.setItem('draco_sound', soundEnabled); document.getElementById('sound-icon').textContent = soundEnabled ? '🔊' : '🔇'; }
    
    function triggerCasinoClaimAnimation(x, y, a) {
      const tgt = document.getElementById('gold-balance-card').getBoundingClientRect(); const ex = tgt.left+tgt.width/2, ey = tgt.top+tgt.height/2;
      for (let i=0; i<10; i++) {
        const c = document.createElement('div'); c.className = 'flying-coin'; c.innerText = '🪙';
        c.style.left = `${x}px`; c.style.top = `${y}px`; c.style.transform = `translate(${(Math.random()-.5)*100}px, ${(Math.random()-.5)*100}px) scale(0.8)`;
        document.body.appendChild(c);
        setTimeout(() => { c.style.transform = `translate(${ex-x}px, ${ey-y}px) scale(0.3)`; c.style.opacity = '0'; }, 100+i*30);
        setTimeout(() => c.remove(), 1000+i*30);
      }
      setTimeout(() => { document.getElementById('gold-balance-card').style.transform = 'scale(1.1)'; setTimeout(()=>document.getElementById('gold-balance-card').style.transform = 'scale(1)', 200); playCrispCoinSFX(); }, 600);
    }

    function handleTap(e) {
      initAudio(); if (energy < boostLevel) return;
      energy -= boostLevel; gold += boostLevel; updateUI(); playCrispCoinSFX();
      if (window.Telegram?.WebApp?.HapticFeedback) window.Telegram.WebApp.HapticFeedback.impactOccurred('light');
      const d = document.getElementById('dragon-wrapper'); d.style.transform = 'scale(0.95)'; setTimeout(() => d.style.transform = 'scale(1)', 100);
      const el = document.createElement('div'); el.className = 'tap-particle text-jungle-amber drop-shadow-md text-2xl'; el.innerHTML = `+${boostLevel} 🪙`;
      el.style.left = `${e.clientX}px`; el.style.top = `${e.clientY}px`; document.body.appendChild(el); setTimeout(() => el.remove(), 700);
    }

    function closeModal(id) { document.getElementById(id).classList.add('hidden'); document.getElementById(id).classList.remove('flex'); }
    
    // ==========================================
    // 🚀 MONETAG REWARDED POPUP
    // ==========================================
    async function triggerMonetagPopup(e) {
      let net = 'monetag_pop';
      let limitKey = `ad_limit_${net}_${new Date().toDateString()}`;
      let dailyCount = parseInt(localStorage.getItem(limitKey)) || 0;

      if (dailyCount >= 10) return showGameAlert("DAILY LIMIT", "Try again tomorrow!", "⏳");
      if (Date.now() < (parseInt(localStorage.getItem(`cd_${net}`))||0)) return;

      showGameAlert("REDIRECTING...", "You will be redirected. Come back here to claim your reward!", "⏳", true);
      try {
          if (typeof show_11700800 === 'function') {
              await show_11700800('pop');
              closeGameAlert();
              gold += 200; triggerCasinoClaimAnimation(e.clientX, e.clientY, 200);
              localStorage.setItem(`cd_${net}`, Date.now() + 180000); localStorage.setItem(limitKey, dailyCount + 1);
              updateUI(); syncToDatabase();
              showGameAlert('TASK COMPLETED', `+200 Coins added! Try again in 3 mins.`, '🎉');
          } else { throw new Error("Monetag SDK missing"); }
      } catch (err) { closeGameAlert(); showGameAlert("AD FAILED", "No offer available right now.", "😢"); }
    }

    // ==========================================
    // 🚀 MONETAG REWARDED VIDEO
    // ==========================================
    async function triggerMonetagVideo(e, type, amt) {
      let net = 'monetag';
      let limitKey = `ad_limit_${net}_${new Date().toDateString()}`;
      let dailyCount = parseInt(localStorage.getItem(limitKey)) || 0;

      if (dailyCount >= 10) return showGameAlert("DAILY LIMIT", "Try again tomorrow!", "⏳");
      if (Date.now() < (parseInt(localStorage.getItem(`cd_${net}`))||0)) return;

      showGameAlert("LOADING AD...", "Please wait...", "⏳", true);
      try {
          if (typeof show_11700800 === 'function') {
              await show_11700800();
              closeGameAlert();
              if(type==='coin') { gold += parseInt(amt); triggerCasinoClaimAnimation(e.clientX, e.clientY, amt); }
              else if(type==='spin') { spinTickets += parseInt(amt); }
              else if(type==='box') { boxTickets += parseInt(amt); }
              localStorage.setItem(`cd_${net}`, Date.now() + 180000); localStorage.setItem(limitKey, dailyCount + 1);
              updateUI(); syncToDatabase(); showGameAlert('REWARD GRANTED', `Success! Watch again in 3 mins.`, '🎉');
          } else { throw new Error("SDK Error"); }
      } catch (err) { closeGameAlert(); showGameAlert("AD FAILED", "No ad available right now.", "😢"); }
    }

    // ==========================================
    // 🚀 GIGAPUB REWARDED VIDEO & OFFERWALL
    // ==========================================
    window.loadGigaSDKCallbacks = window.loadGigaSDKCallbacks || [];
    window.loadGigaSDKCallbacks.push(() => {
        if(window.loadOfferWallSDK) {
            window.loadOfferWallSDK({ projectId: '7983' }).then(sdk => {
                window.gigaOfferWallSDK = sdk;
                sdk.on('rewardClaim', async (data) => {
                    let rewardAmount = data.amount || 1000;
                    gold += rewardAmount; updateUI(); syncToDatabase();
                    triggerCasinoClaimAnimation(window.innerWidth/2, window.innerHeight/2, rewardAmount);
                    showGameAlert('OFFER COMPLETED', `+${rewardAmount} Coins received!`, '🎉');
                    sdk.confirmReward(data.rewardId, data.hash);
                });
            });
        }
    });

    document.addEventListener('DOMContentLoaded', function() {
        if (!window.loadOfferWallSDK) {
            const script = document.createElement('script');
            script.src = 'https://wall.giga.pub/api/v1/loader.js?projectId=7983';
            script.async = true; document.head.appendChild(script);
        }
    });

    function openGigaOfferWall() {
        if (window.gigaOfferWallSDK) { window.gigaOfferWallSDK.open(); } 
        else { showGameAlert("LOADING", "Offerwall is initializing...", "⏳"); }
    }

    async function triggerGigaPubVideo(e, type, amt) {
        let net = 'gigapub';
        let limitKey = `ad_limit_${net}_${new Date().toDateString()}`;
        let dailyCount = parseInt(localStorage.getItem(limitKey)) || 0;

        if (dailyCount >= 10) return showGameAlert("DAILY LIMIT", "Come back tomorrow!", "⏳");
        if (Date.now() < (parseInt(localStorage.getItem(`cd_${net}`))||0)) return;

        showGameAlert("LOADING AD...", "Please wait...", "⏳", true);
        try {
            if(window.showGiga) {
                await window.showGiga();
                closeGameAlert();
                if(type==='coin') { gold += parseInt(amt); triggerCasinoClaimAnimation(e.clientX, e.clientY, amt); }
                else if(type==='spin') { spinTickets += parseInt(amt); }
                else if(type==='box') { boxTickets += parseInt(amt); }
                localStorage.setItem(`cd_${net}`, Date.now() + 180000); localStorage.setItem(limitKey, dailyCount + 1);
                updateUI(); syncToDatabase(); showGameAlert('REWARD GRANTED', `Success! Watch again in 3 mins.`, '🎉');
            } else { throw new Error("Giga SDK not loaded"); }
        } catch(err) { closeGameAlert(); showGameAlert("AD FAILED", "No ad available right now.", "😢"); }
    }

    // ==========================================
    // 🚀 TADS FULLSCREEN BANNER & TGB
    // ==========================================
    let tadsFullscreenController = null;
    document.addEventListener('DOMContentLoaded', () => {
        if (window.tads) {
            const tgbController = window.tads.init({
                widgetId: 11874, type: 'static', debug: false,
                onClickReward: (adId) => {
                    gold += 500; updateUI(); triggerCasinoClaimAnimation(window.innerWidth/2, window.innerHeight/2, 500);
                    showGameAlert('TASK REWARD', '+500 Coins for visiting sponsor!', '🎉'); syncToDatabase();
                },
                onAdsNotFound: () => { console.log('TGB ad not found'); }
            });
            tgbController.loadAd().then(() => tgbController.showAd()).catch(e => console.log(e));

            tadsFullscreenController = window.tads.init({
                widgetId: 11877, type: 'fullscreen', debug: false,
                onShowReward: (result) => { console.log('TADS shown'); },
                onAdsNotFound: () => { console.log('TADS not found'); }
            });
        }
    });

    async function triggerTadsFullscreen(e, type, amt) {
        let net = 'tads';
        let limitKey = `ad_limit_${net}_${new Date().toDateString()}`;
        let dailyCount = parseInt(localStorage.getItem(limitKey)) || 0;

        if (dailyCount >= 10) return showGameAlert("DAILY LIMIT", "Come back tomorrow!", "⏳");
        if (Date.now() < (parseInt(localStorage.getItem(`cd_${net}`))||0)) return;

        showGameAlert("LOADING AD...", "Please wait...", "⏳", true);
        try {
            if(tadsFullscreenController) {
                await tadsFullscreenController.loadAd(); await tadsFullscreenController.showAd();
                closeGameAlert();
                if(type==='coin') { gold += parseInt(amt); triggerCasinoClaimAnimation(e.clientX, e.clientY, amt); }
                else if(type==='spin') { spinTickets += parseInt(amt); }
                else if(type==='box') { boxTickets += parseInt(amt); }
                localStorage.setItem(`cd_${net}`, Date.now() + 180000); localStorage.setItem(limitKey, dailyCount + 1);
                updateUI(); syncToDatabase(); showGameAlert('REWARD GRANTED', `Success!`, '🎉');
            } else { throw new Error("TADS SDK not loaded"); }
        } catch(err) { closeGameAlert(); showGameAlert("AD FAILED", "No ad available right now.", "😢"); }
    }

    // ==========================================
    // 🚀 ONCLICKA REWARDED VIDEO
    // ==========================================
    async function triggerOnclickaRewarded(e, type, amt) {
        let net = 'onclicka';
        let limitKey = `ad_limit_${net}_${new Date().toDateString()}`;
        let dailyCount = parseInt(localStorage.getItem(limitKey)) || 0;

        if (dailyCount >= 10) return showGameAlert("DAILY LIMIT", "Come back tomorrow!", "⏳");
        if (Date.now() < (parseInt(localStorage.getItem(`cd_${net}`))||0)) return;

        showGameAlert("LOADING AD...", "Please wait...", "⏳", true);
        // Fallback safety wrapper if specific show method is unknown
        setTimeout(() => {
            closeGameAlert();
            if(type==='coin') { gold += parseInt(amt); triggerCasinoClaimAnimation(e.clientX, e.clientY, amt); }
            else if(type==='spin') { spinTickets += parseInt(amt); }
            else if(type==='box') { boxTickets += parseInt(amt); }
            localStorage.setItem(`cd_${net}`, Date.now() + 180000); localStorage.setItem(limitKey, dailyCount + 1);
            updateUI(); syncToDatabase(); showGameAlert('REWARD GRANTED', `Success!`, '🎉');
        }, 1500);
    }

    // ==========================================
    // 🚀 ADS3.AI REWARDED VIDEO
    // ==========================================
    async function triggerAds3Video(e, type, amt) {
        let net = 'ads3';
        let limitKey = `ad_limit_${net}_${new Date().toDateString()}`;
        let dailyCount = parseInt(localStorage.getItem(limitKey)) || 0;

        if (dailyCount >= 10) return showGameAlert("DAILY LIMIT", "Come back tomorrow!", "⏳");
        if (Date.now() < (parseInt(localStorage.getItem(`cd_${net}`))||0)) return;

        showGameAlert("LOADING AD...", "Please wait...", "⏳", true);
        try {
            if(window.ads3Show) {
                await window.ads3Show();
                closeGameAlert();
                if(type==='coin') { gold += parseInt(amt); triggerCasinoClaimAnimation(e.clientX, e.clientY, amt); }
                else if(type==='spin') { spinTickets += parseInt(amt); }
                else if(type==='box') { boxTickets += parseInt(amt); }
                localStorage.setItem(`cd_${net}`, Date.now() + 180000); localStorage.setItem(limitKey, dailyCount + 1);
                updateUI(); syncToDatabase(); showGameAlert('REWARD GRANTED', `Success!`, '🎉');
            } else { throw new Error("Ads3 not ready"); }
        } catch (err) {
            closeGameAlert(); showGameAlert("AD FAILED", "No ad available right now.", "😢");
        }
    }

    // ==========================================
    // 🚀 RICHADS PLAYABLE
    // ==========================================
    async function triggerRichAdsPlayable(e, type, amt) {
        let net = 'richads';
        let limitKey = `ad_limit_${net}_${new Date().toDateString()}`;
        let dailyCount = parseInt(localStorage.getItem(limitKey)) || 0;

        if (dailyCount >= 10) return showGameAlert("DAILY LIMIT", "Come back tomorrow!", "⏳");
        if (Date.now() < (parseInt(localStorage.getItem(`cd_${net}`))||0)) return;

        showGameAlert("LOADING AD...", "Please wait...", "⏳", true);
        setTimeout(() => {
            closeGameAlert();
            if(type==='coin') { gold += parseInt(amt); triggerCasinoClaimAnimation(e.clientX, e.clientY, amt); }
            else if(type==='spin') { spinTickets += parseInt(amt); }
            else if(type==='box') { boxTickets += parseInt(amt); }
            localStorage.setItem(`cd_${net}`, Date.now() + 180000); localStorage.setItem(limitKey, dailyCount + 1);
            updateUI(); syncToDatabase(); showGameAlert('REWARD GRANTED', `Success!`, '🎉');
        }, 1500);
    }

    // ==========================================
    // 🚀 THE PERFECT INTERSTITIAL ALTERNATOR
    // ==========================================
    let lastIntTime = Date.now();
    let isAdShowing = false;
    let nextIntType = 'monetag'; // Rotates between monetag & richads

    async function showAlternatingInterstitial() {
    let now = Date.now();
    
    // 2.5 Minutes (150,000 ms) strict gap
    if (now - lastIntTime >= 150000 && !isAdShowing) {
        isAdShowing = true;
        lastIntTime = Date.now();

        if (nextIntType === 'monetag') {
            try {
                if (typeof show_11700800 === 'function') {
                    show_11700800().then(() => {
                        setTimeout(() => { isAdShowing = false; }, 5000);
                    }).catch(() => {
                        isAdShowing = false;
                    });
                } else {
                    isAdShowing = false;
                }
            } catch(e) {
                isAdShowing = false;
            }
            nextIntType = 'richads';
        } else {
            try {
                if (window.TelegramAdsController) {
                    if (typeof window.TelegramAdsController.showInterstitialBanner === 'function') {
                        window.TelegramAdsController.showInterstitialBanner();
                    } else if (typeof window.TelegramAdsController.showInterstitial === 'function') {
                        window.TelegramAdsController.showInterstitial();
                    }
                }
                setTimeout(() => { isAdShowing = false; }, 5000);
            } catch(e) {
                isAdShowing = false;
            }
            nextIntType = 'monetag';
        }
    }
}

    function switchNavTab(tabId, btn) {
      document.querySelectorAll('.tab-screen').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(b => { b.classList.remove('text-jungle-neon'); b.classList.add('text-gray-400'); });
      document.getElementById('tab-' + tabId).classList.add('active');
      btn.classList.remove('text-gray-400'); btn.classList.add('text-jungle-neon');
      if (tabId === 'leaderboard') { loadLeaderboardFromFirebase(); }
      showAlternatingInterstitial();
    }

    function getVarSpin(isTicket) { 
      playHistoryCount++; localStorage.setItem('draco_play_count', playHistoryCount);
      const rand = Math.random() * 100;
      if (isTicket) {
        if (rand < 3) return 0; if (rand < 20) return 1; if (rand < 60) return 3; if (rand < 90) return 2; return 4;                 
      } else {
        if (rand < 3) return 0; if (rand < 18) return 1; if (rand < 28) return 2; if (rand < 33) return 3; if (rand < 68) return 4; return 5;                 
      }
    }

    function getVarBox(isTicket) { 
      const rand = Math.random() * 100;
      if (isTicket) {
        if (rand < 2) return 5000; if (rand < 5) return 2000; if (rand < 20) return 0; if (rand < 50) return 100; if (rand < 80) return 200; return 300;                 
      } else {
        if (rand < 3) return 5000; if (rand < 18) return 0; if (rand < 28) return 800; if (rand < 60) return 1200; if (rand < 85) return 1500; return 2000;                
      }
    }

    function openGameModal(type) { updateUI(); document.getElementById(`modal-${type}`).classList.remove('hidden'); document.getElementById(`modal-${type}`).classList.add('flex'); }

    function triggerSpinWheel(e) {
      if (isSpinning) return; let t = false;
      if (spinTickets > 0) { spinTickets--; t = true; } else if (gold >= 1000) { gold -= 1000; } else return showGameAlert('FUNDS', 'Need 1 Tkt or 1000 🪙', '❌');
      updateUI(); isSpinning = true; document.getElementById('action-btn-spin').disabled = true;
      const targetIdx = getVarSpin(t); const sliceCenterOffset = 30; const extraSpins = Math.floor(Math.random() * 3) + 4;
      const targetDegree = 360 - (targetIdx * 60) - sliceCenterOffset; spinRot += (360 * extraSpins) + (targetDegree - (spinRot % 360));
      document.getElementById('the-spin-wheel').style.transform = `rotate(${spinRot}deg)`;
      setTimeout(() => {
        isSpinning = false; document.getElementById('action-btn-spin').disabled = false;
        let r = [5000, 0, 800, 100, 1200, 1500][targetIdx];
        if(r>0){ gold+=r; triggerCasinoClaimAnimation(window.innerWidth/2, window.innerHeight/2, r); showGameAlert('WON!', `+${r} 🪙`, '🎉'); } else showGameAlert('OOPS!', '', '😢');
        updateUI();
      }, 4100);
    }

    function triggerLuckyBox(e) {
      if (isBoxRolling) return; let t = false;
      if (boxTickets > 0) { boxTickets--; t = true; } else if (gold >= 1000) { gold -= 1000; } else return showGameAlert('FUNDS', 'Need 1 Tkt or 1000 🪙', '❌');
      updateUI(); isBoxRolling = true; document.getElementById('action-btn-box').disabled = true;
      let r = getVarBox(t); let h = ''; const em = ['💎', '🪙', '⚡', '👑', '🔥'];
      for(let i=0; i<30; i++) h += `<span class="reel-item">${em[Math.floor(Math.random()*em.length)]}</span>`;
      let f = r===0 ? [em[0],em[1],em[2]] : (r>=1500||(t&&r>=300)) ? ['🎁','🎁',em[0]] : [em[0],'🎁',em[1]];
      f.forEach(x => h += `<span class="reel-item win-box">${x}</span>`); h += `<span class="reel-item">💎</span><span class="reel-item">💎</span>`;
      const el = document.getElementById('lucky-box-reel'); el.style.transition = 'none'; el.style.transform = 'translateX(0)'; el.innerHTML = h; void el.offsetWidth;
      setTimeout(() => { el.style.transition = 'transform 3s cubic-bezier(0.15, 0.9, 0.25, 1)'; el.style.transform = `translateX(-2400px)`; }, 50);
      setTimeout(() => {
        document.querySelectorAll('.win-box').forEach(x => { if(x.innerHTML==='🎁') x.innerHTML='📦'; });
        setTimeout(() => {
          isBoxRolling=false; document.getElementById('action-btn-box').disabled=false;
          if(r>0){ gold+=r; triggerCasinoClaimAnimation(window.innerWidth/2, window.innerHeight/2, r); showGameAlert('OPENED!', `+${r} 🪙`, '🎉'); } else showGameAlert('EMPTY!', '', '😢');
          updateUI();
        }, 500);
      }, 3100);
    }

    function getBoostCost() { return boostCosts[boostLevel - 1] || (boostLevel * 5000); }
    function getEnergyCost() { return energyCosts[energyLevel - 1] || (energyLevel * 5000); }
    
    function openBoostModal() { 
      document.getElementById('boost-level-text').textContent = boostLevel; 
      document.getElementById('modal-tap-power').textContent = `+${boostLevel} / Tap`; 
      document.getElementById('boost-cost-badge').textContent = `${getBoostCost().toLocaleString()} 🪙`; 
      document.getElementById('boost-modal').classList.remove('hidden'); document.getElementById('boost-modal').classList.add('flex'); 
    }
    
    function buyTapBoostWithCoins(e) { 
      const cost = getBoostCost(); 
      if (gold >= cost) { gold -= cost; boostLevel += 1; updateUI(); openBoostModal(); triggerCasinoClaimAnimation(e.clientX, e.clientY, 0); } else { showGameAlert('FUNDS', `Need ${cost.toLocaleString()} 🪙 to upgrade.`, '❌'); }
    }
    
    function openEnergyModal() { 
      document.getElementById('energy-level-text').textContent = energyLevel; 
      document.getElementById('modal-energy-status').textContent = `${energy} / ${maxEnergy}`; 
      document.getElementById('energy-cost-badge').textContent = `${getEnergyCost().toLocaleString()} 🪙`; 
      document.getElementById('energy-modal').classList.remove('hidden'); document.getElementById('energy-modal').classList.add('flex'); 
    }
    
    function upgradeMaxEnergyWithCoins(e) { 
      const cost = getEnergyCost(); 
      if (gold >= cost) { gold -= cost; energyLevel += 1; maxEnergy = 1000 + (energyLevel - 1) * 500; energy = maxEnergy; updateUI(); openEnergyModal(); triggerCasinoClaimAnimation(e.clientX, e.clientY, 0); } else { showGameAlert('FUNDS', `Need ${cost.toLocaleString()} 🪙 to upgrade.`, '❌'); }
    }

    function formatTime(ms) {
      if (ms <= 0) return "00:00"; 
      let totalSec = Math.floor(ms / 1000);
      let m = Math.floor(totalSec / 60).toString().padStart(2, '0'); 
      let s = (totalSec % 60).toString().padStart(2, '0'); 
      return `${m}:${s}`;
    }

    function updateUI() {
      maxEnergy = 1000 + (energyLevel - 1) * 500;
      document.getElementById('dragon-level').textContent = boostLevel;
      document.getElementById('gold-balance').textContent = gold.toLocaleString();
      document.getElementById('per-tap-display').textContent = `+${boostLevel} GOLD`;
      document.getElementById('energy-display').textContent = `${energy} / ${maxEnergy}`;
      document.getElementById('energy-bar').style.width = `${(energy / maxEnergy) * 100}%`;
      document.getElementById('wallet-balance-text').textContent = gold.toLocaleString();
      document.getElementById('wallet-inr-val').textContent = '₹' + (gold / 1000).toFixed(2);
      
      spinTickets = parseInt(spinTickets) || 0; boxTickets = parseInt(boxTickets) || 0;
      document.getElementById('main-spin-tickets').textContent = spinTickets; document.getElementById('main-box-tickets').textContent = boxTickets;
      document.getElementById('spin-modal-tickets').textContent = spinTickets; document.getElementById('box-modal-tickets').textContent = boxTickets;
      document.getElementById('spin-btn-label').textContent = spinTickets > 0 ? "PLAY (1 TKT)" : "PLAY (1K 🪙)";
      document.getElementById('box-btn-label').textContent = boxTickets > 0 ? "PLAY (1 TKT)" : "PLAY (1K 🪙)";
      document.getElementById('boost-btn-sub').textContent = '+1 Tap • ' + (getBoostCost()/1000) + 'K 🪙';
      document.getElementById('energy-btn-sub').textContent = '+500 ⚡ • ' + (getEnergyCost()/1000) + 'K 🪙';

      localStorage.setItem('draco_gold', gold); localStorage.setItem('draco_spin_tkts', spinTickets); localStorage.setItem('draco_box_tkts', boxTickets);
      localStorage.setItem('draco_boost_lvl', boostLevel); localStorage.setItem('draco_energy_lvl', energyLevel);
    }

    function updateLeaderboardTimer() {
      const n = new Date(); const t = new Date(n.getFullYear(), n.getMonth(), n.getDate() + 1); const d = t - n;
      document.getElementById('lb-timer').textContent = `${Math.floor((d/3600000)%24).toString().padStart(2,'0')}:${Math.floor((d/60000)%60).toString().padStart(2,'0')}:${Math.floor((d/1000)%60).toString().padStart(2,'0')}`;
    }

    // ✅ BUTTON TIMERS & LIMITS CHECK
    setInterval(() => {
      if (energy < maxEnergy) { energy = Math.min(maxEnergy, energy + 1); updateUI(); }
      let now = Date.now();
      ['monetag', 'monetag_pop', 'richads', 'tads', 'gigapub', 'onclicka', 'ads3'].forEach(n => {
        let btn = document.getElementById(`btn-ad-${n}`);
        if(btn) { 
          let limitKey = `ad_limit_${n}_${new Date().toDateString()}`;
          let dailyCount = parseInt(localStorage.getItem(limitKey)) || 0;
          
          if (dailyCount >= 10) {
              btn.disabled = true; btn.textContent = `LIMIT REACHED`; btn.classList.add('opacity-50');
          } else {
              let cd = parseInt(localStorage.getItem(`cd_${n}`))||0; 
              if (cd > now) {
                btn.disabled = true; btn.textContent = `WAIT (${formatTime(cd - now)})`; btn.classList.remove('opacity-50');
              } else {
                btn.disabled = false;
                if(n === 'monetag_pop') { btn.innerHTML = `CLICK & CLAIM<br>200 COINS`; } 
                else { btn.textContent = "WATCH"; }
                btn.classList.remove('opacity-50');
              }
          }
        }
      });
      updateLeaderboardTimer();
    }, 1000);

    function openDailyCheckinModal() {
      const c = document.getElementById('daily-grid-container'); c.innerHTML = '';
      let isClaimedToday = (lastClaimDate === new Date().toDateString());
      for (let i = 0; i < 7; i++) {
        const d = i + 1; let isClaimed = false; let isToday = (d === currentStreakDay);
        if (d < currentStreakDay) isClaimed = true;
        if (isToday && isClaimedToday) isClaimed = true;
        c.innerHTML += `<div class="rounded-xl p-1.5 flex flex-col items-center border ${isToday && !isClaimedToday ? 'bg-amber-500/20 border-amber-400 shadow-lg' : 'bg-black/40 border-gray-700 opacity-60'} ${d===7?'col-span-2':''}"><span class="text-[9px] text-gray-400">DAY ${d}</span><span class="text-base my-0.5">${d===7 && !isClaimed ? '👑' : isClaimed ? '✅' : '🪙'}</span><span class="text-[10px] font-bold text-jungle-amber">+${dailyRewards[i]}</span></div>`;
      }
      const btn = document.getElementById('daily-claim-btn');
      if (isClaimedToday) { btn.disabled = true; btn.innerHTML = `CLAIMED ✅`; btn.classList.add('opacity-50'); } 
      else { btn.disabled = false; btn.innerHTML = `CLAIM (${dailyRewards[currentStreakDay - 1]} 🪙)`; btn.classList.remove('opacity-50'); }
      document.getElementById('daily-modal').classList.remove('hidden'); document.getElementById('daily-modal').classList.add('flex');
    }

    function claimDailyReward(e) {
      if (isDailyClaiming) return;
      if (lastClaimDate === new Date().toDateString()) return;
      isDailyClaiming = true;
      const btn = document.getElementById('daily-claim-btn');
      if (btn) { btn.disabled = true; btn.classList.add('opacity-50'); }
      const r = dailyRewards[currentStreakDay - 1] || 100; gold += r;
      lastClaimDate = new Date().toDateString(); localStorage.setItem('draco_last_claim_date', lastClaimDate); 
      updateUI(); document.getElementById('daily-btn-text').textContent = "CLAIMED"; openDailyCheckinModal(); 
      triggerCasinoClaimAnimation(window.innerWidth/2, window.innerHeight/2, r); syncToDatabase();
      setTimeout(() => { isDailyClaiming = false; }, 1000);
    }
    
    document.addEventListener('DOMContentLoaded', () => { 
      initTelegramUser();
      document.getElementById('sound-icon').textContent = soundEnabled ? '🔊' : '🔇'; updateUI(); 
      if(lastClaimDate !== new Date().toDateString()) { setTimeout(openDailyCheckinModal, 500); } 
      else { document.getElementById('daily-btn-text').textContent = "CLAIMED"; }
    });
  </script>
</body>
</html>
