      <div class="w-full text-left">
        <label class="text-[10px] text-jungle-neon font-mono mb-1 block" id="withdraw-address-label">Address</label>
        <input type="text" id="withdraw-address-input" class="withdraw-input" placeholder="e.g. 9003056016@ybl">
        <label class="text-[10px] text-jungle-amber font-mono mt-2 mb-1 block">Coins to Withdraw</label>
        <input type="number" id="withdraw-amount-input" class="withdraw-input" placeholder="e.g. 100000" oninput="calculateWithdrawValue()">
        <p class="text-[10px] text-gray-400 text-right mt-1" id="withdraw-calc-text">Value: --</p>
        <p class="text-[10px] text-red-500 font-bold text-center mt-1 hidden" id="withdraw-error-text"></p>
      </div>
      <button class="w-full btn-ad-claim text-black font-black py-3 rounded-2xl text-sm font-mono mt-2" onclick="submitWithdrawal()">SUBMIT REQUEST</button>
    </div>
  </div>

  <!-- SPIN WHEEL -->
  <div id="modal-spin" class="fixed inset-0 z-[100] bg-black/90 backdrop-blur-sm hidden items-center justify-center p-4">
