  <!-- WITHDRAW MODAL -->
  <div id="withdraw-modal" class="fixed inset-0 z-[250] bg-black/90 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="upgrade-card rounded-3xl p-6 w-full max-w-sm flex flex-col items-center gap-3 relative popup-animate-in">
      <button class="absolute top-3 right-4 text-gray-400 text-xl" onclick="closeModal('withdraw-modal')">✕</button>
      <div id="withdraw-icon" class="text-4xl mb-1 mt-2">🏦</div>
