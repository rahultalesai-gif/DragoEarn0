      <button class="absolute top-3 right-4 text-gray-400 hover:text-white text-xl" onclick="closeModal('referral-modal')">✕</button>
      <div class="w-16 h-16 rounded-2xl bg-emerald-500/20 flex items-center justify-center text-4xl shadow-inner mt-2">👥</div>
      <h3 class="text-xl font-black text-white font-mono uppercase text-center">Refer & Earn</h3>
      <div class="w-full bg-black/50 p-3 rounded-xl border border-jungle-neon/30 text-left">
