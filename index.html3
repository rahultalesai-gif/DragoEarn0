      <div class="relative mt-2 mb-2"><div class="wheel-pointer">🔻</div>
        <div id="the-spin-wheel" class="wheel-container">
          <div class="wheel-label" style="transform: rotate(30deg); top:0;">5000<br>🪙</div><div class="wheel-label" style="transform: rotate(90deg); top:0;">OOPS<br>😢</div>
          <div class="wheel-label" style="transform: rotate(150deg); top:0;">800<br>🪙</div><div class="wheel-label" style="transform: rotate(210deg); top:0;">100<br>🪙</div>
          <div class="wheel-label" style="transform: rotate(270deg); top:0;">1200<br>🪙</div><div class="wheel-label" style="transform: rotate(330deg); top:0;">1500<br>🪙</div>
        </div>
