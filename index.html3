<!DOCTYPE html>
<html class="dark" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport"/>
<title>Jungle Draco - Pro Tap to Earn</title>

<!-- Telegram WebApp SDK -->
<script src="https://telegram.org/js/telegram-web-app.js"></script>

<!-- Firebase SDKs (v9 Compat) -->
<script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-firestore-compat.js"></script>

<!-- Monetag SDK -->
<script src='//libtl.com/sdk.js' data-zone='11700800' data-sdk='show_11700800'></script>

<!-- GigaPub SDK -->
<script src="https://ad.gigapub.tech/script?id=7983"></script>

<!-- TADS SDK -->
<script src="https://w.tads.me/widget.js"></script>

<!-- Ads3.ai SDK -->
<script src="https://cdn.jsdelivr.net/npm/ton-ai-sdk/dist/ton-ai-sdk.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
      try { TonAdInit({ appId: '6a9566cdb924d710e19f4d70', debug: false }); } catch(e){}
      try { 
        window.initCdTma?.({ id: '6a9566cdb924d710e19f4d70' }).then(show => {
            window.ads3Show = show;
        }).catch(e => console.log(e)); 
      } catch(e){}
  });
</script>

<!-- Onclicka SDKs -->
<script src="https://js.onclckvd.com/in-stream-ad-admanager/tma.js" data-zone="6143690" async data-cfasync="false"></script>
<script src="https://js.onclckvd.com/in-stream-ad-admanager/tma.js" data-zone="6140556" async data-cfasync="false"></script>

<!-- RichAds SDK -->
<script src="https://richinfo.co/richpartners/telegram/js/tg-ob.js"></script>
<script>
  window.TelegramAdsController = new TelegramAdsController();
  window.TelegramAdsController.initialize({
    pubId: "1016289",
    appId: "8739",
  });
</script>

<!-- Fonts -->
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Plus+Jakarta+Sans:wght@500;700;800;900&family=JetBrains+Mono:wght@700;800&display=swap" rel="stylesheet"/>

<!-- Tailwind CSS -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    darkMode: "class",
    theme: {
      extend: {
        colors: {
          "jungle-dark": "#02150d",
          "jungle-surface": "#06281a",
          "jungle-card": "#0b3825",
          "jungle-neon": "#4edea3",
          "jungle-gold": "#f59e0b",
          "jungle-amber": "#fbbf24"
        },
        fontFamily: {
          "body": ["Plus Jakarta Sans", "sans-serif"],
          "title": ["Cinzel", "serif"],
          "mono": ["JetBrains Mono", "monospace"]
        },
        animation: {
          'dragon-float': 'dragonHover 3.5s ease-in-out infinite',
          'pedestal-glow': 'pedestalGlow 3s ease-in-out infinite',
          'firefly-1': 'floatParticle 6s ease-in-out infinite',
          'firefly-2': 'floatParticle 8s ease-in-out infinite 1.5s',
          'radar-ping': 'radarPing 1.5s cubic-bezier(0, 0, 0.2, 1) infinite',
          'spin-fast': 'spin 1s linear infinite'
        },
        keyframes: {
          dragonHover: { '0%, 100%': { transform: 'translateY(0) scale(1)' }, '50%': { transform: 'translateY(-14px) scale(1.02)' } },
          pedestalGlow: { '0%, 100%': { opacity: 0.6, transform: 'scale(1)' }, '50%': { opacity: 0.9, transform: 'scale(1.1)' } },
          floatParticle: { '0%, 100%': { transform: 'translate(0, 0)', opacity: 0.2 }, '50%': { transform: 'translate(25px, -40px)', opacity: 0.9 } },
          radarPing: { '75%, 100%': { transform: 'scale(2)', opacity: '0' } }
        }
      }
    }
  }
</script>

<style>
  * { -webkit-tap-highlight-color: transparent; user-select: none; touch-action: manipulation; }
  body { background: radial-gradient(circle at 50% 30%, #0d4a30 0%, #042013 55%, #010e08 100%); min-height: 100dvh; font-family: 'Plus Jakarta Sans', sans-serif; overflow-x: hidden; }
  .stone-contact-shadow { background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.95) 0%, rgba(2, 21, 13, 0.7) 50%, transparent 75%); filter: blur(12px); }
  .dragon-blended { filter: drop-shadow(0 0 25px rgba(78, 222, 163, 0.5)) drop-shadow(0 20px 30px rgba(0, 0, 0, 0.85)); transition: transform 0.1s cubic-bezier(0.175, 0.885, 0.32, 1.275); }

  .tap-particle { position: fixed; z-index: 9999; pointer-events: none; font-family: 'JetBrains Mono', monospace; font-weight: 900; animation: popUp 0.75s ease-out forwards; }
  @keyframes popUp { 0% { transform: translate(-50%, 0) scale(0.6); opacity: 1; } 50% { transform: translate(-50%, -45px) scale(1.35); opacity: 1; } 100% { transform: translate(-50%, -90px) scale(0.85); opacity: 0; } }
  .flying-coin { position: fixed; z-index: 99999; pointer-events: none; font-size: 22px; filter: drop-shadow(0 0 8px #f59e0b); transition: transform 0.85s cubic-bezier(0.19, 1, 0.22, 1), opacity 0.85s ease-in; }

  .jungle-panel { background: rgba(6, 40, 26, 0.85); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid rgba(78, 222, 163, 0.25); box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5); }
  .tab-screen { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.2s ease, transform 0.2s ease; }
  .tab-screen.active { display: flex; opacity: 1; transform: translateY(0); }

  .btn-claim { background: linear-gradient(135deg, #4edea3 0%, #10b981 100%); box-shadow: 0 4px 15px rgba(78, 222, 163, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.4); transition: all 0.2s ease; }
  .btn-claim:active:not(:disabled) { transform: scale(0.92); }
  .btn-claim:disabled { background: #374151; box-shadow: none; color: #9ca3af; opacity: 0.7; }

  .btn-ad-claim { background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%); box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.4); transition: all 0.2s ease; }
  .btn-ad-claim:active:not(:disabled) { transform: scale(0.92); }
  .btn-ad-claim:disabled { background: #374151; box-shadow: none; color: #9ca3af; opacity: 0.7; }

  .upgrade-card { background: linear-gradient(145deg, rgba(6, 40, 26, 0.9), rgba(2, 21, 13, 0.95)); border: 1px solid rgba(78, 222, 163, 0.3); box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.6); }
  .popup-animate-in { animation: popupIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
  @keyframes popupIn { 0% { transform: scale(0.8); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }

  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); border-radius: 4px; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #4edea3; border-radius: 4px; }

  /* SPIN WHEEL CSS */
  .wheel-container { position: relative; width: 240px; height: 240px; border-radius: 50%; overflow: hidden; border: 4px solid #fbbf24; box-shadow: 0 0 25px rgba(245, 158, 11, 0.5); background: conic-gradient(#10b981 0 60deg, #064e3b 60deg 120deg, #10b981 120deg 180deg, #064e3b 180deg 240deg, #10b981 240deg 300deg, #064e3b 300deg 360deg); transition: transform 4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
  .wheel-label { position: absolute; width: 100px; height: 120px; left: 50%; transform-origin: bottom center; text-align: center; padding-top: 15px; margin-left: -50px; font-weight: 900; color: white; text-shadow: 1px 1px 3px black; display: flex; flex-direction: column; justify-content: flex-start; align-items: center; font-family: 'JetBrains Mono', monospace; font-size: 14px; }
  .wheel-pointer { position: absolute; top: -15px; left: 50%; transform: translateX(-50%); font-size: 35px; z-index: 10; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.5)); }

  /* WITHDRAW INPUT CSS */
  .withdraw-input { width: 100%; background: rgba(0, 0, 0, 0.6); border: 1px solid rgba(78, 222, 163, 0.4); color: #ffffff; border-radius: 8px; padding: 12px; font-family: 'JetBrains Mono', monospace; font-size: 14px; outline: none; margin-bottom: 8px; box-shadow: inset 0 2px 5px rgba(0,0,0,0.5); }
  .withdraw-input:focus { border-color: #4edea3; box-shadow: 0 0 8px rgba(78, 222, 163, 0.5), inset 0 2px 5px rgba(0,0,0,0.5); }
  .withdraw-input::placeholder { color: #9ca3af; }

  /* LUCKY BOX 3-SLOT REEL CSS */
  .lucky-reel-wrapper { width: 240px; height: 80px; margin: 0 auto; background: #000; border-radius: 12px; border: 2px solid #4edea3; overflow: hidden; position: relative; box-shadow: inset 0 0 20px rgba(0,0,0,1); }
  .lucky-reel-content { display: flex; align-items: center; height: 100%; width: max-content; }
  .reel-item { width: 80px; height: 80px; display: flex; justify-content: center; align-items: center; font-size: 45px; flex-shrink: 0; }
  .reel-center-mark { position: absolute; top: 0; bottom: 0; left: 80px; width: 80px; border-left: 2px solid rgba(78,222,163,0.5); border-right: 2px solid rgba(78,222,163,0.5); background: linear-gradient(90deg, transparent, rgba(78,222,163,0.2), transparent); pointer-events: none; z-index: 10; }
</style>
</head>

<body class="text-white flex flex-col justify-between min-h-screen p-3 pb-2 relative">

  <!-- BACKGROUND LIGHTS -->
  <div class="fixed top-12 left-10 w-2.5 h-2.5 rounded-full bg-jungle-neon blur-[1px] animate-firefly-1 pointer-events-none"></div>
  <div class="fixed top-1/3 right-8 w-3 h-3 rounded-full bg-jungle-amber blur-[1px] animate-firefly-2 pointer-events-none"></div>
  <div class="fixed top-0 left-1/2 -translate-x-1/2 w-96 h-96 bg-jungle-neon/10 rounded-full blur-[100px] pointer-events-none"></div>

  <!-- ================= TOP HEADER ================= -->
  <header id="main-header" class="flex flex-col gap-2 z-20">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div id="tg-avatar-box" class="w-8 h-8 rounded-full bg-emerald-500/20 border border-jungle-neon/40 flex items-center justify-center text-sm font-bold shadow-md text-jungle-neon">🐉</div>
        <div>
          <h1 id="tg-user-name" class="text-xs font-mono uppercase text-jungle-neon font-bold tracking-wider">JUNGLE EXPLORER</h1>
          <p class="text-[10px] text-gray-300">@<span id="tg-user-handle">player</span> • Lvl <span id="dragon-level">1</span></p>
        </div>
      </div>
      <div class="flex items-center gap-1.5">
        <button class="bg-amber-500/20 border border-amber-400/40 px-3 py-1 rounded-full text-xs active:scale-90 flex items-center gap-1.5 text-jungle-amber font-mono font-bold shadow-md" onclick="openDailyCheckinModal()">
          <span>🎁</span> <span id="daily-btn-text">DAILY</span>
        </button>
        <button id="sound-toggle-btn" class="bg-jungle-surface/80 border border-jungle-neon/30 p-1.5 rounded-full text-xs active:scale-90" onclick="toggleSound()">
          <span id="sound-icon">🔊</span>
        </button>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-2 mt-0.5">
      <div id="gold-balance-card" class="jungle-panel rounded-2xl p-2.5 flex items-center justify-between border-jungle-amber/30 transition-transform duration-200">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-amber-500/20 border border-amber-400/30 flex items-center justify-center text-lg shadow-inner">🪙</div>
          <div>
            <div class="text-[9px] font-mono text-gray-400">GOLD COINS</div>
            <div class="text-base font-black text-jungle-amber font-mono" id="gold-balance">0</div>
          </div>
        </div>
      </div>
      <div class="jungle-panel rounded-2xl p-2.5 flex items-center justify-between border-jungle-neon/30">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-lg shadow-inner">⚡</div>
          <div>
            <div class="text-[9px] font-mono text-gray-400">PER TAP</div>
            <div class="text-base font-black text-jungle-neon font-mono" id="per-tap-display">+1 GOLD</div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ================= SECTION 1: HOME ================= -->
  <main id="tab-home" class="tab-screen active flex-1 flex-col items-center justify-center my-auto z-10 w-full mt-2">
    <div class="relative w-full max-w-[340px] h-[280px] flex flex-col items-center justify-center cursor-pointer" id="dragon-container" onclick="handleTap(event)">
      <div class="absolute w-72 h-72 rounded-full bg-gradient-to-tr from-jungle-neon/25 via-emerald-600/15 to-transparent blur-3xl animate-pedestal-glow pointer-events-none"></div>
      <div class="absolute bottom-1 w-72 h-20 pointer-events-none flex items-center justify-center">
        <div class="w-68 h-16 bg-gradient-to-b from-[#1b3d2b] to-[#091b12] rounded-[50%] border-t-2 border-emerald-400/50 shadow-[0_15px_35px_rgba(0,0,0,0.95)] relative overflow-hidden">
          <div class="absolute top-1 left-6 w-16 h-3.5 bg-emerald-500/35 rounded-full blur-[2px]"></div>
          <div class="absolute top-2 right-10 w-20 h-3.5 bg-emerald-400/30 rounded-full blur-[2px]"></div>
        </div>
        <div class="absolute top-2 w-56 h-10 stone-contact-shadow"></div>
      </div>
      <div id="dragon-wrapper" class="relative z-10 w-[270px] h-[270px] flex items-center justify-center animate-dragon-float will-change-transform">
        <img id="dragon-image" src="https://i.ibb.co/Xk4Pp210/835112748-1787289753732459-removebg-preview.png" alt="Jungle Dragon" class="w-full h-full object-contain dragon-blended pointer-events-none" />
      </div>
    </div>

    <!-- Boost & Energy -->
    <div class="w-full max-w-sm grid grid-cols-2 gap-2.5 mt-2.5 mb-1.5 px-1">
      <button class="jungle-panel hover:bg-emerald-900/60 active:scale-95 transition-transform rounded-2xl p-2.5 flex items-center justify-between border-jungle-neon/40 shadow-lg group" onclick="openBoostModal()">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-jungle-neon/20 flex items-center justify-center text-base">🚀</div>
          <div class="text-left">
            <div class="text-xs font-black text-jungle-neon tracking-wide">Boost</div>
            <div class="text-[9px] text-gray-300 font-mono" id="boost-btn-sub">+1 Tap</div>
          </div>
        </div>
        <span class="text-xs text-jungle-neon font-bold">➔</span>
      </button>
      <button class="jungle-panel hover:bg-emerald-900/60 active:scale-95 transition-transform rounded-2xl p-2.5 flex items-center justify-between border-jungle-amber/40 shadow-lg group" onclick="openEnergyModal()">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-amber-500/20 flex items-center justify-center text-base">🔋</div>
          <div class="text-left">
            <div class="text-xs font-black text-jungle-amber tracking-wide">Energy</div>
            <div class="text-[9px] text-gray-300 font-mono" id="energy-btn-sub">+500 ⚡</div>
          </div>
        </div>
        <span class="text-xs text-jungle-amber font-bold">➔</span>
      </button>
    </div>

    <div class="w-full max-w-sm flex flex-col gap-1 px-1">
      <div class="flex items-center justify-between text-xs font-mono">
        <div class="flex items-center gap-1.5 text-jungle-neon font-extrabold">
          <span>⚡</span><span id="energy-display">1000 / 1000</span>
        </div>
        <div class="text-gray-400 text-[10px]">⚡ +1 Energy/sec</div>
      </div>
      <div class="w-full h-3 bg-jungle-dark rounded-full overflow-hidden p-0.5 border border-jungle-neon/30 shadow-inner">
        <div id="energy-bar" class="h-full bg-gradient-to-r from-emerald-500 via-jungle-neon to-jungle-amber rounded-full transition-all duration-150" style="width: 100%;"></div>
      </div>
    </div>
  </main>

  <!-- ================= SECTION 2: TASKS ================= -->
  <main id="tab-task" class="tab-screen flex-1 flex-col gap-3 my-auto z-10 w-full max-w-md mx-auto py-2">
    <div class="text-center mb-1">
      <h2 class="text-xl font-extrabold text-jungle-neon font-mono">SPONSOR QUESTS</h2>
      <p class="text-xs text-gray-400">Complete offers to earn premium game passes</p>
    </div>

    <div class="flex flex-col gap-2.5 h-[62vh] overflow-y-auto pb-24 pr-1 custom-scrollbar">

      <!-- NEW MONETAG REWARDED POPUP BUTTON -->
      <div class="jungle-panel rounded-2xl p-3 flex items-center justify-between border-amber-500/40">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-white/10 p-1 flex items-center justify-center shadow-inner">
            <img src="https://i.ibb.co/ZsVp3bv/images-2-removebg-preview.png" class="w-full h-full object-contain" alt="Monetag Elite">
          </div>
          <div>
            <h4 class="font-bold text-xs">Monetag Elite Offer</h4>
            <p class="text-[11px] text-jungle-amber font-mono font-bold">Reward: +200 🪙</p>
          </div>
        </div>
        <button id="btn-ad-monetag_pop" class="btn-claim text-black font-black px-2 py-1.5 rounded-xl text-[8px] font-mono tracking-wider w-24 text-center leading-tight shadow-md" onclick="triggerMonetagPopup(event)">CLICK & CLAIM<br>200 COINS</button>
      </div>

      <!-- REFER A FRIEND -->
      <div class="bg-gradient-to-r from-jungle-card to-[#0d3623] rounded-2xl p-3 flex items-center justify-between border border-jungle-neon/60 shadow-[0_0_15px_rgba(78,222,163,0.2)]">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center text-2xl shadow-inner">👥</div>
          <div>
            <h4 class="font-black text-xs text-white tracking-wide">Refer A Friend</h4>
            <p class="text-[11px] text-jungle-neon font-mono font-bold">Reward: +5000 🪙</p>
          </div>
        </div>
        <button class="btn-claim text-black font-black px-4 py-2 rounded-xl text-[10px] font-mono tracking-wider shadow-lg active:scale-95" onclick="openReferralModal()">INVITE</button>
      </div>

      <!-- Monetag Rewarded Video -->
      <div class="jungle-panel rounded-2xl p-3 flex items-center justify-between border-amber-500/20">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-white/10 p-1 flex items-center justify-center shadow-inner">
            <img src="https://i.ibb.co/ZsVp3bv/images-2-removebg-preview.png" class="w-full h-full object-contain" alt="Monetag">
          </div>
          <div>
            <h4 class="font-bold text-xs">Monetag Offer</h4>
            <p class="text-[11px] text-jungle-neon font-mono font-bold">Reward: +1 Spin 🎡</p>
          </div>
        </div>
        <button id="btn-ad-monetag" class="btn-claim text-black font-black px-3 py-2 rounded-xl text-[10px] font-mono tracking-wider w-24 text-center" onclick="triggerMonetagVideo(event, 'spin', 1)">WATCH</button>
      </div>

      <!-- GigaPub OfferWall -->
      <div class="jungle-panel rounded-2xl p-3 flex items-center justify-between border-emerald-500/20">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-white/10 p-1 flex items-center justify-center shadow-inner">
            <img src="https://i.ibb.co/v6PmgwJV/1766836321888-gigapub-logo-removebg-preview.png" class="w-full h-full object-contain scale-110" alt="Gigapub">
          </div>
          <div>
            <h4 class="font-bold text-xs">GigaPub OfferWall</h4>
            <p class="text-[11px] text-jungle-neon font-mono font-bold">Reward: Unlimited 🪙</p>
          </div>
        </div>
        <button class="bg-gray-200 text-black font-black px-3 py-2 rounded-xl text-[10px] font-mono tracking-wider w-24 text-center shadow-md active:scale-95" onclick="openGigaOfferWall()">OPEN</button>
      </div>

      <!-- GigaPub Rewarded Video -->
      <div class="jungle-panel rounded-2xl p-3 flex items-center justify-between border-emerald-500/20">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-white/10 p-1 flex items-center justify-center shadow-inner">
            <img src="https://i.ibb.co/v6PmgwJV/1766836321888-gigapub-logo-removebg-preview.png" class="w-full h-full object-contain scale-110" alt="Gigapub">
          </div>
          <div>
            <h4 class="font-bold text-xs">Gigapub Media</h4>
            <p class="text-[11px] text-jungle-neon font-mono font-bold">Reward: +1 Box 🎁</p>
          </div>
        </div>
        <button id="btn-ad-gigapub" class="bg-gray-200 text-black font-black px-3 py-2 rounded-xl text-[10px] font-mono tracking-wider w-24 text-center shadow-md active:scale-95" onclick="triggerGigaPubVideo(event, 'box', 1)">WATCH</button>
      </div>

      <!-- RichAds Playable Ad -->
      <div class="jungle-panel rounded-2xl p-3 flex items-center justify-between border-amber-500/20">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-white/10 p-1 flex items-center justify-center shadow-inner">
            <span class="text-2xl">🎮</span>
          </div>
          <div>
            <h4 class="font-bold text-xs">RichAds Playable</h4>
            <p class="text-[11px] text-jungle-neon font-mono font-bold">Reward: +1 Spin 🎡</p>
          </div>
        </div>
        <button id="btn-ad-richads" class="btn-claim text-black font-black px-3 py-2 rounded-xl text-[10px] font-mono tracking-wider w-24 text-center" onclick="triggerRichAdsPlayable(event, 'spin', 1)">WATCH</button>
      </div>

      <!-- Onclicka Rewarded Video -->
      <div class="jungle-panel rounded-2xl p-3 flex items-center justify-between border-emerald-500/20">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-white/10 p-1 flex items-center justify-center shadow-inner">
            <span class="text-2xl">📺</span>
          </div>
          <div>
            <h4 class="font-bold text-xs">Onclicka Ad</h4>
            <p class="text-[11px] text-jungle-neon font-mono font-bold">Reward: +1 Box 🎁</p>
          </div>
